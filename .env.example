# Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# OCR Engine: "vietocr", "paddleocr", "hybrid", or "auto"
# auto: tries hybrid first (best accuracy), then paddleocr, then vietocr
# hybrid: PaddleOCR for text detection + VietOCR for recognition
OCR_ENGINE=auto

# VietOCR model config (vgg_transformer, vgg_seq2seq, vgg_seq2seq_s)
VIETOCR_MODEL=vgg_transformer

# Google Sheets (optional - for Google Sheet output)
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Output format: "json", "excel", "gsheet", "markdown", or "all"
OUTPUT_FORMAT=json

# Upload directory
UPLOAD_DIR=uploads
RESULTS_DIR=results
